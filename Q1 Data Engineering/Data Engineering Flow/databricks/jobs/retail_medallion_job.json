{
  "name": "retail_medallion_job",
  "description": "Retail medallion workflow: bronze → silver → gold (standalone Databricks job)",
  "email_notifications": { "on_failure": [], "on_success": [] },
  "timeout_seconds": 7200,
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "bronze_pos",
      "notebook_task": {
        "notebook_path": "/Repos/retail-data-engineering/databricks/notebooks/bronze/bronze_pos_transactions",
        "base_parameters": { "environment": "dev", "storage_account": "stretaildatalakedev", "container": "retaildatalake" }
      }
    },
    {
      "task_key": "bronze_inventory",
      "notebook_task": {
        "notebook_path": "/Repos/retail-data-engineering/databricks/notebooks/bronze/bronze_inventory",
        "base_parameters": { "environment": "dev", "storage_account": "stretaildatalakedev", "container": "retaildatalake" }
      }
    },
    {
      "task_key": "bronze_customers",
      "notebook_task": {
        "notebook_path": "/Repos/retail-data-engineering/databricks/notebooks/bronze/bronze_customers",
        "base_parameters": { "environment": "dev", "storage_account": "stretaildatalakedev", "container": "retaildatalake" }
      }
    },
    {
      "task_key": "bronze_products",
      "notebook_task": {
        "notebook_path": "/Repos/retail-data-engineering/databricks/notebooks/bronze/bronze_products",
        "base_parameters": { "environment": "dev", "storage_account": "stretaildatalakedev", "container": "retaildatalake" }
      }
    },
    {
      "task_key": "bronze_stores",
      "notebook_task": {
        "notebook_path": "/Repos/retail-data-engineering/databricks/notebooks/bronze/bronze_stores",
        "base_parameters": { "environment": "dev", "storage_account": "stretaildatalakedev", "container": "retaildatalake" }
      }
    },
    {
      "task_key": "silver_all",
      "depends_on": [
        { "task_key": "bronze_pos" },
        { "task_key": "bronze_inventory" },
        { "task_key": "bronze_customers" },
        { "task_key": "bronze_products" },
        { "task_key": "bronze_stores" }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/Repos/retail-data-engineering/databricks/notebooks/silver/silver_pos_transactions",
        "base_parameters": { "storage_account": "stretaildatalakedev", "container": "retaildatalake" }
      }
    },
    {
      "task_key": "gold_fact_sales",
      "depends_on": [{ "task_key": "silver_all" }],
      "notebook_task": {
        "notebook_path": "/Repos/retail-data-engineering/databricks/notebooks/gold/gold_fact_sales",
        "base_parameters": { "storage_account": "stretaildatalakedev", "container": "retaildatalake" }
      }
    },
    {
      "task_key": "gold_inventory",
      "depends_on": [{ "task_key": "silver_all" }],
      "notebook_task": {
        "notebook_path": "/Repos/retail-data-engineering/databricks/notebooks/gold/gold_inventory_analytics",
        "base_parameters": { "storage_account": "stretaildatalakedev", "container": "retaildatalake" }
      }
    },
    {
      "task_key": "gold_segments",
      "depends_on": [{ "task_key": "silver_all" }],
      "notebook_task": {
        "notebook_path": "/Repos/retail-data-engineering/databricks/notebooks/gold/gold_customer_segments",
        "base_parameters": { "storage_account": "stretaildatalakedev", "container": "retaildatalake" }
      }
    },
    {
      "task_key": "gold_dims",
      "depends_on": [{ "task_key": "gold_fact_sales" }],
      "notebook_task": {
        "notebook_path": "/Repos/retail-data-engineering/databricks/notebooks/gold/gold_dim_retail",
        "base_parameters": { "storage_account": "stretaildatalakedev", "container": "retaildatalake" }
      }
    }
  ],
  "format": "MULTI_TASK"
}
